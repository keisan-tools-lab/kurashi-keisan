---
import Layout from '../layouts/Layout.astro';
import InputCard from '../components/InputCard.astro';
import Result from '../components/Result.astro';
import Answer from '../components/Answer.astro';
import Field from '../components/Field.astro';
---
<Layout slug="age">
  <InputCard title="生年月日を選んでください">
    <div class="grid2">
      <Field id="birth" type="date" label="生年月日" value="1960-04-10" />
      <Field id="base" type="date" label="いつの時点の年齢か（ふつうは今日）" />
    </div>
  </InputCard>

  <Result>
    <Answer id="out" label="満年齢" />
    <dl class="rows" id="rows"></dl>
  </Result>
</Layout>

<script>
  import { $, val, fmt, rows, watch, isoDate, parseDate, jpDate, DAY, problem, wareki } from '../scripts/util';

  ($('base') as HTMLInputElement).value = isoDate(new Date());

  const SHI = ['子', '丑', '寅', '卯', '辰', '巳', '午', '未', '申', '酉', '戌', '亥'];
  const ANIMAL = ['ねずみ', 'うし', 'とら', 'うさぎ', 'たつ', 'へび', 'うま', 'ひつじ', 'さる', 'とり', 'いぬ', 'いのしし'];
  const KAN = ['甲', '乙', '丙', '丁', '戊', '己', '庚', '辛', '壬', '癸'];
  // [月, その月で星座が切り替わる日, その日から始まる星座]
  const STARS: [number, number, string][] = [
    [1, 20, 'みずがめ座'], [2, 19, 'うお座'], [3, 21, 'おひつじ座'], [4, 20, 'おうし座'],
    [5, 21, 'ふたご座'], [6, 22, 'かに座'], [7, 23, 'しし座'], [8, 23, 'おとめ座'],
    [9, 23, 'てんびん座'], [10, 24, 'さそり座'], [11, 23, 'いて座'], [12, 22, 'やぎ座'],
  ];
  const CELEBRATE: [number, string][] = [
    [60, '還暦'], [70, '古希'], [77, '喜寿'], [80, '傘寿'], [88, '米寿'], [90, '卒寿'], [99, '白寿'], [100, '百寿'],
  ];
  const mod = (a: number, n: number) => ((a % n) + n) % n;

  function star(m: number, d: number): string {
    const i = STARS.findIndex(([sm, sd]) => m === sm && d < sd);
    return i >= 0 ? STARS[mod(i - 1, 12)][2] : STARS[m - 1][2];
  }

  function update() {
    const b = parseDate(val('birth')), t = parseDate(val('base'));
    if (b === null || t === null) { $('out').textContent = '—'; $('rows').innerHTML = ''; return; }
    if (b > t) { problem('生年月日が「いつの時点の年齢か」より後の日になっています。'); return; }
    const B = new Date(b), T = new Date(t);
    const by = B.getUTCFullYear(), bm = B.getUTCMonth() + 1, bd = B.getUTCDate();
    const ty = T.getUTCFullYear(), tm = T.getUTCMonth() + 1, td = T.getUTCDate();

    const age = ty - by - (tm < bm || (tm === bm && td < bd) ? 1 : 0);
    $('out').innerHTML = `${age}<small>歳</small>`;

    // 次の誕生日（2月29日生まれは、うるう年でない年は3月1日にします）
    const bdayIn = (y: number) => {
      const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
      return bm === 2 && bd === 29 && !leap ? Date.UTC(y, 2, 1) : Date.UTC(y, bm - 1, bd);
    };
    let next = bdayIn(ty);
    if (next < t) next = bdayIn(ty + 1);
    const untilNext = Math.round((next - t) / DAY);

    const nextC = CELEBRATE.find(([a]) => a > age);
    const list: [string, string][] = [
      ['数え年', `${ty - by + 1} 歳`],
      ['生まれ年（和暦）', `${wareki(by, bm, bd)}（${by}年）`],
      ['干支', `${KAN[mod(by - 4, 10)]}${SHI[mod(by - 4, 12)]}（${ANIMAL[mod(by - 4, 12)]}年）`],
      ['星座', star(bm, bd)],
      ['生まれてから', `${fmt(Math.round((t - b) / DAY))} 日目`],
      ['次の誕生日まで', untilNext === 0 ? '今日がお誕生日です' : `あと ${untilNext} 日（${jpDate(next)}）`],
    ];
    if (nextC) list.push([`次の長寿のお祝い`, `${nextC[1]}（${nextC[0]}歳）まであと ${nextC[0] - age} 年`]);
    $('rows').innerHTML = rows(list);
  }
  watch(update);
</script>
